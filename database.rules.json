        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'super_admin' || ((root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'hospital_admin') && root.child('users').child(auth.uid).child('hospitalId').val() === $hospitalId))"
      }
    }
  }
}
